<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Phone access · Orby" Width="580" Height="660" MinWidth="540" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#141518" Foreground="#F5F6F8" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#24262B"/><Setter Property="Foreground" Value="#F5F6F8"/><Setter Property="BorderBrush" Value="#454950"/></Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,8"/></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F5F6F8"/><Setter Property="Margin" Value="0,0,0,12"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#202226"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,12"/></Style></Window.Resources>
 <DockPanel Margin="22"><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="PhoneMessage" Foreground="#AEB4BF"/><StackPanel Orientation="Horizontal"><Button x:Name="PhoneSave" Content="Save connection" Background="#F5F6F8" Foreground="#141518"/><Button x:Name="PhoneClose" Content="Close"/></StackPanel></StackPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Your tasks, on your phone" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Your trusted phone shows project summaries and can answer supported questions and permissions." Foreground="#9398A1"/>
  <CheckBox x:Name="PhoneEnabled" Content="Enable phone access"/><CheckBox x:Name="PhoneApprovals" Content="Let trusted phones answer questions and permissions"/>
  <Expander Header="Connection details" Foreground="#ADB2BC" Margin="0,0,0,18"><StackPanel Margin="0,12,0,0"><TextBlock Text="Relay HTTPS address"/><TextBox x:Name="PhoneOrigin"/><TextBlock Text="PC connection code (leave blank to keep the saved code)"/><PasswordBox x:Name="PhoneSecret" Height="36" Padding="8" Background="#202226" Foreground="White" Margin="0,0,0,14"/></StackPanel></Expander>
  <TextBlock Text="1 · Connect your iPhone" FontWeight="SemiBold"/><Button x:Name="PhoneInvite" Content="Create invitation / QR code" HorizontalAlignment="Left" Margin="0,0,0,8"/><Image x:Name="PhoneQr" Width="200" Height="200" HorizontalAlignment="Left" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,10"/><TextBlock x:Name="PhoneQrNote" Text="Scan the QR code with your iPhone camera. No paid Apple membership is needed for the browser version." FontSize="12" Foreground="#ADB2BC"/><TextBox x:Name="PhoneInvitation" IsReadOnly="True" ToolTip="Manual code for native clients. The QR code fills this in automatically on your iPhone."/>
  <TextBlock Text="2 · Compare the fingerprint on both screens" FontWeight="SemiBold"/><Button x:Name="PhoneRefresh" Content="Refresh phones" HorizontalAlignment="Left" Margin="0,0,0,10"/><StackPanel x:Name="PhoneDevices"/>
  <TextBlock Text="Unanswered ChatGPT/Codex questions move to your phone after five minutes. Phone notifications need Orby on the iPhone Home Screen and notification permission. Stop and custom replies are available only when the current desktop controls are unambiguous and accessible. The PC and relay must stay awake." Foreground="#9398A1" FontSize="11" Margin="0,14,0,12"/>
 </StackPanel></ScrollViewer></DockPanel>
</Window>
