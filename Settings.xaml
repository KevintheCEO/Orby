<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Orby settings" Width="590" Height="730" WindowStartupLocation="CenterScreen" Background="#111516" Foreground="#E8EEEB" ResizeMode="CanMinimize">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C9D5CE"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EEEB"/><Setter Property="Margin" Value="0,0,16,10"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#202728"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3B4642"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#273630"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#41564A"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#70CCAA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="Make Orby yours" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
  <TextBlock Text="Choose connections. Everything you configure is saved on this computer." Margin="0,2,0,18"/>
  <WrapPanel><CheckBox x:Name="EnableMusic" Content="Music"/><CheckBox x:Name="EnableNotifications" Content="Notifications"/><CheckBox x:Name="EnableHealth" Content="Computer health"/><CheckBox x:Name="EnableDownloads" Content="Downloads"/><CheckBox x:Name="EnableTasks" Content="AI tasks"/><CheckBox x:Name="EnableWatchlist" Content="Watchlist"/></WrapPanel>
  <WrapPanel><CheckBox x:Name="EnableReducedMotion" Content="Reduce avatar motion"/><CheckBox x:Name="EnableSounds" Content="Soft Orby sounds"/><CheckBox x:Name="EnableStartWithWindows" Content="Start Orby with Windows"/><CheckBox x:Name="EnableQuiet" Content="Quiet mode"/><CheckBox x:Name="EnablePreview" Content="Show notification previews"/></WrapPanel>
  <TextBlock Text="Notification apps (comma-separated; leave blank for all)"/><TextBox x:Name="NotificationApps"/>
  <TextBlock x:Name="NotificationHelp" Text="Notification Center access depends on Windows permissions. Visible banners are the fallback." FontSize="10" TextWrapping="Wrap"/>
  <Button x:Name="EnableNotificationAccess" Content="Request Windows notification access" HorizontalAlignment="Left"/>
  <TextBlock Text="Preferred media app ID (optional; blank uses current session)"/><TextBox x:Name="MediaApp"/><TextBlock x:Name="MediaHelp" FontSize="10" TextWrapping="Wrap"/>
  <TextBlock Text="Download folder"/><DockPanel><Button x:Name="BrowseDownloadFolder" Content="Browse" DockPanel.Dock="Right"/><TextBox x:Name="DownloadFolder"/></DockPanel>
  <TextBlock Text="Watchlist topics (up to 10 tickers or companies, comma-separated)"/><TextBox x:Name="SettingsWatchTopics"/>
  <CheckBox x:Name="EnableAllowPublicNews" Content="Allow Google News searches for my watchlist topics"/>
  <TextBlock Text="When enabled, Orby sends these topics to news.google.com every 5 minutes. Notification contents and files are never included." FontSize="10" TextWrapping="Wrap"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Focus minutes"/><TextBox x:Name="FocusMinutes"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Break reminder minutes (0 = off)"/><TextBox x:Name="BreakMinutes"/></StackPanel></Grid>
  <TextBlock Text="Favorite apps" FontWeight="SemiBold"/>
  <ListBox x:Name="FavoriteList" Height="75" Background="#202728" Foreground="White" DisplayMemberPath="Name"/>
  <WrapPanel Margin="0,7,0,8"><Button x:Name="AddFavorite" Content="Add app"/><Button x:Name="RemoveFavorite" Content="Remove selected"/><Button x:Name="LaunchFavorite" Content="Open selected"/></WrapPanel>
  <TextBlock x:Name="SettingsMessage" Text="" Foreground="#8FE1B1" TextWrapping="Wrap"/>
  <WrapPanel><Button x:Name="SaveSettings" Content="Save settings"/><Button x:Name="CloseSettings" Content="Close"/></WrapPanel>
 </StackPanel></ScrollViewer>
</Window>
