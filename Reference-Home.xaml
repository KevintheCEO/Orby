<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="180" Margin="8,0,8,0">
 <Grid.Resources><Style TargetType="Button"><Setter Property="Background" Value="#202124"/><Setter Property="Foreground" Value="#B9BDC3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="132"/><RowDefinition Height="20"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,4"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="RefHome" Content="&#x2302;" ToolTip="Home" Margin="0,0,5,0"/><Button x:Name="RefMusic" Content="&#x266B;" ToolTip="Music player" Margin="0,0,5,0"/><Button x:Name="RefTools" Content="&#x25A6;" ToolTip="Desktop controls" Margin="0,0,5,0"/><Button x:Name="RefAnimations" Content="&#x2726;" ToolTip="Your animations" Margin="0,0,5,0"/><Button x:Name="RefSettings" Content="+" ToolTip="Settings"/></StackPanel><TextBlock x:Name="RefHealth" Text="Connecting" Foreground="#B5B8BD" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
 <Grid x:Name="RefHomePage" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#171619" CornerRadius="18" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="102"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Ellipse Width="96" Height="96"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#7046C5FF" Offset="0"/><GradientStop Color="#0046C5FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse><Viewbox x:Name="RefOrbHost" Width="98" Height="98" VerticalAlignment="Center"/></Grid>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="CHATGPT" FontSize="9" Foreground="#737780" Margin="0,0,0,8"/><TextBlock x:Name="RefTitle" Text="No active task" Foreground="#F1F2F4" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36"/><TextBlock x:Name="RefAction" Text="Waiting for a task" Foreground="#C5C7CD" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RefDetail" Text="Orby is ready" Foreground="#747880" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
  </Grid></Border>
  <Border Grid.Column="2" Background="#151417" CornerRadius="18" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="RefPill0" Background="#0B2528" BorderBrush="#275A5D" BorderThickness="1" CornerRadius="18" Margin="0,3,0,4" Padding="8"><DockPanel><Canvas Width="17" Height="17" Margin="0,0,6,0"><Ellipse Width="17" Height="17" Fill="#4BB6B3"/><Ellipse Width="2.3" Height="5.5" Fill="#171619" Canvas.Left="5" Canvas.Top="5.5"/><Ellipse Width="2.3" Height="5.5" Fill="#171619" Canvas.Left="10" Canvas.Top="5.5"/></Canvas><TextBlock x:Name="RefPillText0" Text="ChatGPT idle" FontSize="10" Foreground="#82CFCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
   <Border x:Name="RefPill1" Grid.Column="2" Background="#2C1119" BorderBrush="#5D2538" BorderThickness="1" CornerRadius="18" Margin="0,3,0,4" Padding="8"><DockPanel><Canvas Width="17" Height="17" Margin="0,0,6,0"><Ellipse Width="17" Height="17" Fill="#EE4A6B"/><Ellipse Width="2.3" Height="5.5" Fill="#171619" Canvas.Left="5" Canvas.Top="5.5"/><Ellipse Width="2.3" Height="5.5" Fill="#171619" Canvas.Left="10" Canvas.Top="5.5"/></Canvas><TextBlock x:Name="RefPillText1" Text="No alerts" FontSize="10" Foreground="#E996A9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
   <Border x:Name="RefPill2" Grid.Row="1" Background="#2A2111" BorderBrush="#5C4726" BorderThickness="1" CornerRadius="18" Margin="0,4,0,3" Padding="8"><DockPanel><Canvas Width="17" Height="17" Margin="0,0,6,0"><Ellipse Width="17" Height="17" Fill="#F3AB3E"/><Ellipse Width="2.3" Height="5.5" Fill="#171619" Canvas.Left="5" Canvas.Top="5.5"/><Ellipse Width="2.3" Height="5.5" Fill="#171619" Canvas.Left="10" Canvas.Top="5.5"/></Canvas><TextBlock x:Name="RefPillText2" Text="Focus off" FontSize="10" Foreground="#E7C27D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
   <Border x:Name="RefPill3" Grid.Row="1" Grid.Column="2" Background="#21152F" BorderBrush="#4B2C65" BorderThickness="1" CornerRadius="18" Margin="0,4,0,3" Padding="8"><DockPanel><Canvas Width="17" Height="17" Margin="0,0,6,0"><Ellipse Width="17" Height="17" Fill="#A85AF0"/><Ellipse Width="2.3" Height="5.5" Fill="#171619" Canvas.Left="5" Canvas.Top="5.5"/><Ellipse Width="2.3" Height="5.5" Fill="#171619" Canvas.Left="10" Canvas.Top="5.5"/></Canvas><TextBlock x:Name="RefPillText3" Text="Files ready" FontSize="10" Foreground="#CAA2EE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid></Border>
  </Grid>
  <Grid x:Name="RefMusicPage" Grid.Row="1" Visibility="Collapsed" Margin="8,0,8,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#171619" CornerRadius="18" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="82" Height="82" CornerRadius="14" Background="#252A31"><Border.Clip><RectangleGeometry Rect="0,0,82,82" RadiusX="14" RadiusY="14"/></Border.Clip><Image x:Name="RefMusicCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="SPOTIFY" Foreground="#69D99A" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="RefMusicTitle" Text="No Spotify track" Foreground="#F1F2F4" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><TextBlock x:Name="RefMusicArtist" Text="Play a song in Spotify" Foreground="#9DA7B2" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock x:Name="RefMusicNotice" Text="Music controls" Foreground="#68737D" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/></StackPanel></Grid></Border>
  <Border Grid.Column="2" Background="#151417" CornerRadius="18" Padding="12"><StackPanel><Slider x:Name="RefMusicSeek" Height="18" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" ToolTip="Seek in this track"/><DockPanel><TextBlock x:Name="RefMusicPosition" Text="--:--" Foreground="#89939E" FontSize="9"/><TextBlock x:Name="RefMusicDuration" Text="--:--" Foreground="#89939E" FontSize="9" HorizontalAlignment="Right"/></DockPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0"><Button x:Name="RefMusicShuffle" Content="&#x2928;" ToolTip="Shuffle" Width="28" Margin="0,2,4,2"/><Button x:Name="RefMusicPrevious" Content="&#x23EE;" ToolTip="Previous" Width="31" Margin="0,2,4,2"/><Button x:Name="RefMusicPlay" Content="&#x25B6;" ToolTip="Play or pause" Width="38" Background="#317C55" Margin="0,2,4,2"/><Button x:Name="RefMusicNext" Content="&#x23ED;" ToolTip="Next" Width="31" Margin="0,2,4,2"/><Button x:Name="RefMusicRepeat" Content="&#x21BB;" ToolTip="Repeat" Width="28" Margin="0,2,0,2"/></StackPanel></StackPanel></Border>
 </Grid>
 <TextBlock Grid.Row="2" x:Name="RefConnection" Text="Local activity" Foreground="#575B63" FontSize="9" Margin="8,5,0,0"/>
</Grid>
