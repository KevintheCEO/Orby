<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Orby animations" Width="580" Height="380" Background="#101114" Foreground="White" WindowStartupLocation="CenterScreen">
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <ListBox x:Name="Clips" DisplayMemberPath="Name" Background="#191B20" Foreground="White" BorderBrush="#353844"/>
  <StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="Your animation pack" FontSize="19" FontWeight="SemiBold"/><Viewbox x:Name="PreviewHost" Width="220" Height="190" Margin="0,15,0,8"/><TextBlock x:Name="ClipInfo" TextWrapping="Wrap" Foreground="#B7BDC7"/><CheckBox x:Name="Reduced" Content="Reduce motion" Foreground="White" Margin="0,12,0,8"/><TextBlock Text="Preview only. Tasks keep their real state." FontSize="10" Foreground="#727986" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>
