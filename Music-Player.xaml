<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="350" CornerRadius="20" Background="#121418" BorderBrush="#35393E" BorderThickness="1" Padding="18">
 <Border.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#D9DEE4"/><Setter Property="Background" Value="#23272D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3B444D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Border.Resources>
 <StackPanel>
  <DockPanel Margin="0,0,0,13"><Button x:Name="MusicClose" DockPanel.Dock="Right" Content="&#x00D7;" FontSize="16" ToolTip="Close player"/><TextBlock Text="SPOTIFY" Foreground="#69D99A" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Width="64" Height="64" HorizontalAlignment="Left" CornerRadius="12" Background="#262B32"><Border.Clip><RectangleGeometry Rect="0,0,64,64" RadiusX="12" RadiusY="12"/></Border.Clip><Image x:Name="MusicCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PlayerTitle" Text="No Spotify track" FontSize="16" FontWeight="SemiBold" Foreground="#F2F4F7" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlayerArtist" Foreground="#9DA7B2" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
  </Grid>
  <Slider x:Name="PlayerSeek" Margin="0,16,0,0" Minimum="0" Maximum="1" Height="20" IsMoveToPointEnabled="True" ToolTip="Seek in this track">
   <Slider.Template><ControlTemplate TargetType="Slider"><Grid>
    <Border Height="3" Background="#394149" CornerRadius="1.5" Margin="5,0"/>
    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" CornerRadius="1.5" Background="#69D99A"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="11" Height="11"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#ECF9F1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Slider.Template>
  </Slider>
  <DockPanel><TextBlock x:Name="PlayerDuration" DockPanel.Dock="Right" Foreground="#89939E" FontSize="10"/><TextBlock x:Name="PlayerPosition" Foreground="#89939E" FontSize="10"/></DockPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,13,0,0">
   <Button x:Name="PlayerShuffle" Content="&#x2928;" ToolTip="Shuffle" Width="37" Margin="0,5,9,5"/>
   <Button x:Name="PlayerPrevious" ToolTip="Previous track" Width="40" Margin="0,5,9,5"><Path Fill="#D9DEE4" Data="M 0,0 L 2,0 2,14 0,14 Z M 13,0 L 13,14 3,7 Z"/></Button>
   <Button x:Name="PlayerPlay" ToolTip="Play or pause" Width="48" Height="43" Background="#317C55"><Path x:Name="PlayerPlayIcon" Fill="#EDFFF5" Data="M 0,0 L 14,8 0,16 Z"/></Button>
   <Button x:Name="PlayerNext" ToolTip="Next track" Width="40" Margin="9,5,9,5"><Path Fill="#D9DEE4" Data="M 11,0 L 13,0 13,14 11,14 Z M 0,0 L 10,7 0,14 Z"/></Button>
   <Button x:Name="PlayerRepeat" Content="&#x21BB;" ToolTip="Repeat" Width="37" Margin="0,5,0,5"/>
  </StackPanel>
  <DockPanel Margin="0,13,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PlayerVolumeDown" Content="-" ToolTip="System volume down"/><Button x:Name="PlayerMute" Content="&#x266B;" ToolTip="Mute system audio" Margin="4,0"/><Button x:Name="PlayerVolumeUp" Content="+" ToolTip="System volume up"/></StackPanel><TextBlock Text="System volume" Foreground="#798591" FontSize="10" VerticalAlignment="Center"/></DockPanel>
  <TextBlock x:Name="PlayerNotice" Foreground="#A7B2BE" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>
 </StackPanel>
</Border>
