<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
 <ScrollViewer.Resources><Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"><Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#41434B" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style></ScrollViewer.Resources>
 <Border x:Name="HomeFrame" Margin="0,4,0,0" Background="Transparent">
 <Grid x:Name="HomeCanvas" Height="294">
  <Grid.Resources>
   <SolidColorBrush x:Key="Ink" Color="#EFF0F3"/><SolidColorBrush x:Key="Muted" Color="#9A9DA7"/>
   <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
   <Style x:Key="Quiet" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="10.5"/></Style>
   <Style x:Key="Panel" TargetType="Border"><Setter Property="BorderBrush" Value="#292B32"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="#101115"/></Style>
   <Style x:Key="IconButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F5F7FD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#202128"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B9BDC9"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="RoundPlay" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Ellipse x:Name="Disc" Stroke="#4B4D57" StrokeThickness="0.5"><Ellipse.Fill><SolidColorBrush Color="#1A1B21"/></Ellipse.Fill></Ellipse><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Stroke" Value="#A7ABB5"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disc" Property="Stroke" Value="#B9BDC9"/><Setter TargetName="Disc" Property="StrokeThickness" Value="1.5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Disc" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="Timeline" TargetType="Slider"><Setter Property="Height" Value="12"/><Setter Property="Foreground" Value="#EFF0F3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="#363840" VerticalAlignment="Center"/><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" Background="#EFF0F3" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="8" Height="12"><Thumb.Template><ControlTemplate><Ellipse Fill="#EFF0F3" Width="8" Height="8"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition x:Name="HomeAIRow" Height="58"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition x:Name="HomeWaterGap" Height="0"/><RowDefinition x:Name="HomeWaterRow" Height="0"/></Grid.RowDefinitions>
 <Border x:Name="HomeAICard" Style="{StaticResource Panel}" Padding="10,6">
  <Grid>
   <Grid x:Name="HomeIdleAI"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Viewbox x:Name="HomeIdleAvatar" Width="44" Height="46" HorizontalAlignment="Left"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,24,0"><TextBlock Text="All quiet" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="NoActive" Text="Your AIs appear here when working" Style="{StaticResource Quiet}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
   </Grid>
   <Grid x:Name="HomeActiveAI" Visibility="Collapsed" Margin="0,0,24,0"><Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ActiveTotal" Text="Active AI" FontSize="10" Foreground="#9A9DA7" Margin="3,0,0,0"/><UniformGrid x:Name="ActiveProviders" Grid.Row="1" Columns="3" Margin="0,3,0,0"/></Grid>
   <Button x:Name="HomeAIOptions" Style="{StaticResource IconButton}" Width="26" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Open AI choices"><Path Stroke="#9A9DA7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,0 L5,5 L10,0" Width="10" Height="6" Stretch="Uniform"/></Button>
  </Grid>
 </Border>
 <Border x:Name="HomeMusicCard" Grid.Row="2" Style="{StaticResource Panel}">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="HomeCoverColumn" Width="144"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="HomeCoverFrame" Width="124" Height="124" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#18191F" BorderBrush="#34363E" BorderThickness="1" CornerRadius="10"><Grid><Path x:Name="MusicPlaceholder" Fill="#777A86" Data="M9,3 L28,0 L28,22 C28,29 16,31 16,24 C16,20 22,18 25,20 L25,6 L12,8 L12,26 C12,33 0,35 0,28 C0,24 6,22 9,24 Z" Width="32" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="HomeMusicCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,22,0"><TextBlock x:Name="HomeMusicTitle" Text="Nothing playing" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><ContentControl x:Name="HomeSourceLogo" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock x:Name="MusicSource" Text="Your current player" FontSize="12" Foreground="#9A9DA7" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="HomeMusicArtist" Visibility="Collapsed"/></StackPanel>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="12"/><RowDefinition Height="16"/></Grid.RowDefinitions><Slider x:Name="HomeMusicSeek" Style="{StaticResource Timeline}" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" IsEnabled="False"/><TextBlock x:Name="HomeMusicPosition" Grid.Row="1" Text="—:—" FontSize="10" Foreground="#9A9DA7"/><TextBlock x:Name="HomeMusicDuration" Grid.Row="1" Text="—:—" FontSize="10" Foreground="#9A9DA7" HorizontalAlignment="Right"/></Grid>
    <UniformGrid Grid.Row="2" Columns="3" Width="180" HorizontalAlignment="Center"><Button x:Name="HomePrevious" Style="{StaticResource IconButton}" Width="34" Height="34" ToolTip="Previous track"><Path Fill="#EFF0F3" Data="M0,0 H3 V20 H0 Z M17,0 V20 L3,10 Z" Width="11" Height="14" Stretch="Uniform"/></Button><Button x:Name="HomePlay" Style="{StaticResource RoundPlay}" ToolTip="Play or pause"><Path x:Name="HomePlayGlyph" Fill="#EFF0F3" Data="M1,0 H6 V20 H1 Z M12,0 H17 V20 H12 Z" Width="12" Height="14" Stretch="Uniform"/></Button><Button x:Name="HomeNext" Style="{StaticResource IconButton}" Width="34" Height="34" ToolTip="Next track"><Path Fill="#EFF0F3" Data="M12,0 H15 V20 H12 Z M0,0 V20 L14,10 Z" Width="11" Height="14" Stretch="Uniform"/></Button></UniformGrid>
   </Grid>
   <Button x:Name="OpenMusic" Grid.Column="1" Style="{StaticResource IconButton}" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Open full music player"><Path Stroke="#9A9DA7" StrokeThickness="1.4" Width="10" Height="10" Stretch="Uniform" Data="M1,1 L8,1 L8,8 M8,1 L0,9"/></Button>
  </Grid>
 </Border>
 <Grid x:Name="HomePersonalHost" Grid.Row="4" Visibility="Collapsed"/>
 </Grid></Border>
</ScrollViewer>
