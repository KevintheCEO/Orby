<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="596" Height="198" UseLayoutRounding="True" SnapsToDevicePixels="True" TextElement.FontFamily="Segoe UI" TextElement.FontWeight="Normal" TextElement.Foreground="#EFF0F3" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
 <Grid.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#202128"/><Setter Property="Foreground" Value="#DDE0E8"/><Setter Property="BorderBrush" Value="#30323D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#596176"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#85B8FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="Tag" Value="Active"><Setter Property="Foreground" Value="#8FE8BB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#101115"/><Setter Property="BorderBrush" Value="#292B32"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="14"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="38" Height="26" Background="Transparent"><Border x:Name="Rail" Height="18" CornerRadius="9" Background="#41444D"/><Ellipse x:Name="Dot" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" Margin="2,0,2,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="#35D783"/><Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#B6B9C4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chip" Background="#252730" CornerRadius="5" Padding="12,5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#2279F1"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions>
 <DockPanel><StackPanel x:Name="MenuNav" Orientation="Horizontal" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="MenuHealthDot" Width="5" Height="5" Fill="#38D58B" Margin="0,0,5,0"/><TextBlock x:Name="MenuHealth" Text="Online" FontSize="12" Foreground="#ADB2BC"/></StackPanel></DockPanel>
 <Grid x:Name="HomeMenu" Grid.Row="1"/>
 <Border x:Name="ChatMenu" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <DockPanel><Button x:Name="UsageRefresh" Content="↻" DockPanel.Dock="Right" Width="32" Height="32" Padding="0" ToolTip="Refresh usage"/><Viewbox x:Name="ChatAvatar" Width="52" Height="52" DockPanel.Dock="Left" Margin="0,0,8,0"/><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><ContentControl x:Name="ChatLogo" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="ChatGPT / Codex" FontWeight="Bold" FontSize="15"/></StackPanel><TextBlock x:Name="ChatStatus" Text="Ready" Foreground="#A7AFBA" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel>
  <StackPanel Grid.Row="1" x:Name="QuotaHost" Margin="66,2,2,0"/>
  <Border Grid.Row="2" CornerRadius="7" Background="#1A1B21" Padding="7,3"><DockPanel><TextBlock Text="▥  Codex activity" FontSize="12"/><ContentControl x:Name="TokenSlot" DockPanel.Dock="Right" HorizontalAlignment="Right"/><ContentControl x:Name="PeriodSlot" Margin="8,0,6,0" HorizontalAlignment="Right"/></DockPanel></Border>
 </Grid></Border>
 <Border x:Name="ClaudeMenu" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <DockPanel><Button x:Name="LocalUsageOpen" Content="Open usage" DockPanel.Dock="Right" Padding="10,6" FontSize="12" VerticalAlignment="Center"/><Viewbox x:Name="ClaudeAvatar" Width="50" Height="50" Margin="0,0,8,0" DockPanel.Dock="Left"/><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><ContentControl x:Name="ClaudeLogo" Width="19" Height="19" Margin="0,0,5,0"/><TextBlock x:Name="LocalProviderName" Text="Claude" FontSize="16" FontWeight="Bold"/></StackPanel><TextBlock x:Name="ClaudeStatus" Text="Ready" Foreground="#B3A89F" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="#191A20" CornerRadius="7" Padding="12,9" Margin="0,4,0,4"><StackPanel><DockPanel><TextBlock Text="▣  Desktop chat" FontSize="12"/><TextBlock x:Name="ClaudeDesktop" Text="Waiting for activity" FontSize="12" Foreground="#A9B2BC" HorizontalAlignment="Right"/></DockPanel><DockPanel x:Name="LocalCodeRow" Margin="0,7,0,0"><TextBlock Text="⌘  Claude Code" FontSize="12"/><TextBlock x:Name="ClaudeCode" Text="Sync off" FontSize="12" Foreground="#A9B2BC" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
  <StackPanel Grid.Row="2" Margin="0,4,0,4">
   <DockPanel><TextBlock Text="5-hour window" FontSize="12"/><TextBlock x:Name="LocalSessionPercent" Text="Not available" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
   <ProgressBar x:Name="LocalSessionBar" Minimum="0" Maximum="100" Height="5" Margin="0,4,0,8" Foreground="#48D68D" Background="#343943" Visibility="Hidden"/>
   <DockPanel><TextBlock Text="Weekly usage" FontSize="12"/><TextBlock x:Name="LocalWeekPercent" Text="Not available" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
   <ProgressBar x:Name="LocalWeekBar" Minimum="0" Maximum="100" Height="5" Margin="0,4,0,6" Foreground="#48D68D" Background="#343943" Visibility="Hidden"/>
   <TextBlock x:Name="LocalUsageNote" Text="Open your provider's Usage page to connect." Foreground="#A9B2BC" FontSize="11" TextWrapping="Wrap"/>
  </StackPanel>
  <DockPanel Grid.Row="3"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="LocalConnections" Content="Connections" FontSize="11" Padding="10,6" Margin="0,0,4,0"/><Button x:Name="LocalCodeSync" Content="Code sync" FontSize="11" Padding="10,6"/></StackPanel><TextBlock Text="Account usage · remaining" Foreground="#818896" FontSize="11"/></DockPanel>
 </Grid></Border>
 <Border x:Name="MusicMenu" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed"><Border.Background><RadialGradientBrush Center="0.05,0.2" GradientOrigin="0.05,0.2" RadiusX="0.7" RadiusY="1.3"><GradientStop x:Name="MusicTint" Color="#00101115"/><GradientStop Color="#FF101115" Offset="1"/></RadialGradientBrush></Border.Background><Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="88"/><RowDefinition Height="42"/><RowDefinition Height="48"/><RowDefinition Height="34"/></Grid.RowDefinitions><Button x:Name="ChooseMusicSource" Grid.ColumnSpan="2" Content="Player: Automatic  ▾" FontSize="12" Padding="8,2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="28" ToolTip="Choose Automatic or a detected music app. For YouTube Music on the web, select your browser."/>
  <Border Grid.Row="1" Width="80" Height="80" CornerRadius="10" HorizontalAlignment="Left" Background="#171B24"><Border.Clip><RectangleGeometry Rect="0,0,80,80" RadiusX="10" RadiusY="10"/></Border.Clip><ContentControl x:Name="CoverSlot"/></Border>
  <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"><ContentControl x:Name="TitleSlot"/><ContentControl x:Name="ArtistSlot" Margin="0,3,0,0"/><ContentControl x:Name="NoticeSlot" Margin="0,3,0,0"/></StackPanel>
  <Grid Grid.Row="2" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><ContentControl x:Name="PositionSlot"/><ContentControl Grid.Column="1" x:Name="SeekSlot"/><ContentControl Grid.Column="2" x:Name="DurationSlot" HorizontalAlignment="Right"/></Grid>
  <StackPanel Grid.Row="3" Grid.ColumnSpan="2" x:Name="PlaybackHost" Orientation="Horizontal" HorizontalAlignment="Center"/>
  <DockPanel Grid.Row="4" Grid.ColumnSpan="2"><TextBlock Text="♬" Foreground="#A9B2BC" Margin="0,0,6,0"/><ContentControl x:Name="VolumeValueSlot" DockPanel.Dock="Right" Width="42" HorizontalAlignment="Right"/><ContentControl x:Name="VolumeSlot"/></DockPanel>
 </Grid></Border>
 <Border x:Name="SettingsMenu" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="36"/><RowDefinition Height="12"/><RowDefinition Height="82"/><RowDefinition Height="14"/><RowDefinition Height="36"/><RowDefinition Height="12"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <TextBlock Text="Make Orby yours" FontWeight="SemiBold" FontSize="16"/>
  <DockPanel Grid.Row="1"><TextBlock Text="Notch size" FontSize="13"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><RadioButton x:Name="SizeDefault" GroupName="Size" Content="Default" FontSize="12"/><RadioButton x:Name="SizeMini" GroupName="Size" Content="Mini" FontSize="12" Margin="6,0,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="6"/><RowDefinition Height="38"/></Grid.RowDefinitions>
   <DockPanel><CheckBox x:Name="QuickMusic" DockPanel.Dock="Right"/><TextBlock Text="Music" FontSize="12"/></DockPanel>
   <DockPanel Grid.Column="2"><CheckBox x:Name="QuickSounds" DockPanel.Dock="Right"/><TextBlock Text="Soft sounds" FontSize="12"/></DockPanel>
   <DockPanel Grid.Row="2"><CheckBox x:Name="QuickHideFullscreen" DockPanel.Dock="Right"/><TextBlock Text="Hide in full-screen apps" FontSize="12"/></DockPanel>
   <DockPanel Grid.Row="2" Grid.Column="2"><CheckBox x:Name="QuickReducedMotion" DockPanel.Dock="Right"/><TextBlock Text="Reduced motion" FontSize="12"/></DockPanel>
  </Grid>
  <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="QuickConnections" Content="AI connections" FontSize="12" Height="36"/><Button x:Name="QuickMusicApp" Grid.Column="2" Content="Music app" FontSize="12" Height="36"/></Grid>
  <DockPanel Grid.Row="7" LastChildFill="False"><Button x:Name="QuickSave" Content="Save changes" Background="#2279F1" Foreground="White" FontSize="12" Padding="16,6" DockPanel.Dock="Right" Height="36"/><TextBlock x:Name="SettingsNote" Text="" FontSize="11" Foreground="#83CDA7" DockPanel.Dock="Right" Margin="0,0,12,0"/><Button x:Name="MoreSettings" Content="More settings  ›" FontSize="12" Padding="12,6" HorizontalAlignment="Left" Height="36"/></DockPanel>
 </Grid></Border>
 <TextBlock x:Name="MenuFooter" Grid.Row="2" FontSize="11" Foreground="#808691" Text="Local connections" Margin="4,0,4,0"/>
</Grid>
