<Window UseLayoutRounding="True" SnapsToDevicePixels="True" TextElement.FontWeight="Normal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Orby settings" Width="640" MinWidth="590" Height="760" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#111318" Foreground="#E8EEEB" ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources><Style TargetType="ComboBox"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#E8EEEB"/><Setter Property="Background" Value="#22262D"/><Setter Property="BorderBrush" Value="#3B4642"/></Style><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E8EEEB"/><Setter Property="Background" Value="#22262D"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style x:Key="MediaPicker" TargetType="ComboBox"><Setter Property="Foreground" Value="#E8EEEB"/><Setter Property="Background" Value="#22262D"/><Setter Property="BorderBrush" Value="#3B4655"/><Setter Property="MinHeight" Value="32"/><Setter Property="MaxDropDownHeight" Value="240"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#22262D" BorderBrush="#3B4655" BorderThickness="1" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter TextElement.Foreground="#E8EEEB" Margin="9,4" VerticalAlignment="Center" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate,RelativeSource={RelativeSource AncestorType=ComboBox}}"/><Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#ADB9CA" StrokeThickness="1.4" Width="8" Height="4" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#22262D" BorderBrush="#3B4655" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="#171A21"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4F5868" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C9D5CE"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EEEB"/><Setter Property="Margin" Value="0,0,16,10"/><Setter Property="MinHeight" Value="24"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="18" Height="18" Background="#191E26" BorderBrush="#505A6C" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center"><Path x:Name="Tick" Data="M3,8 L7,12 L14,4" Width="12" Height="10" Stretch="Uniform" Stroke="White" StrokeThickness="1.8" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#2279F1"/><Setter TargetName="Box" Property="BorderBrush" Value="#448EF3"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#9AC9FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#22262D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3B4642"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#29323D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#41564A"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#70CCAA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <DockPanel LastChildFill="True">
  <Border DockPanel.Dock="Bottom" Background="#171A21" BorderBrush="#303540" BorderThickness="0,1,0,0" Padding="24,12"><StackPanel><TextBlock x:Name="SettingsMessage" Text="" Foreground="#8FE1B1" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button x:Name="SaveSettings" Content="Save settings" Background="#2279F1" MinWidth="120"/><Button x:Name="CloseSettings" Content="Close" MinWidth="80"/></StackPanel></StackPanel></Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,24,24,12">
  <TextBlock Text="Make Orby yours" FontSize="24" FontWeight="Bold" Foreground="White"/>
  <TextBlock Text="Choose connections. Everything you configure is saved on this computer." Margin="0,2,0,18"/>
  <TextBlock Text="Notch size" FontWeight="Bold" Margin="0,8,0,6"/>
  <WrapPanel Margin="0,0,0,8"><RadioButton x:Name="DefaultNotchSize" GroupName="NotchSize" Content="Default Orby" Foreground="#E8EEEB" FontWeight="Bold" Margin="0,0,20,0"/><RadioButton x:Name="MiniNotchSize" GroupName="NotchSize" Content="Mini Orby" Foreground="#E8EEEB" FontWeight="Bold"/></WrapPanel>
  <TextBlock Text="Mini is a tiny top notch. Hover to open the full-size menu." FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock Text="Connections and features" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,12"/><Button x:Name="AIConnections" Content="AI connections · connect or switch" HorizontalAlignment="Left"/><WrapPanel><CheckBox x:Name="EnableMusic" Content="Music"/><CheckBox x:Name="EnableNotifications" Content="Notifications"/><CheckBox x:Name="EnableHealth" Content="Computer health"/><CheckBox x:Name="EnableDownloads" Content="Downloads"/><CheckBox x:Name="EnableTasks" Content="AI tasks"/><CheckBox x:Name="EnableWatchlist" Content="Watchlist"/></WrapPanel>
  <TextBlock Text="Appearance and behavior" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,12"/><WrapPanel><CheckBox x:Name="EnableHideFullscreen" Content="Hide during full-screen apps and games"/><CheckBox x:Name="EnableEyeEffects" Content="Occasional colourful eye styles"/><CheckBox x:Name="EnableReducedMotion" Content="Reduce avatar motion"/><CheckBox x:Name="EnableSounds" Content="Soft Orby sounds"/><CheckBox x:Name="EnableStartWithWindows" Content="Start Orby with Windows"/><CheckBox x:Name="EnableQuiet" Content="Quiet mode"/><CheckBox x:Name="EnablePreview" Content="Show notification previews"/></WrapPanel>
  <TextBlock Text="Notification apps (comma-separated; leave blank for all)"/><TextBox x:Name="NotificationApps"/>
  <TextBlock x:Name="NotificationHelp" Text="Notification Center access depends on Windows permissions. Visible banners are the fallback." FontSize="10" TextWrapping="Wrap"/>
  <Button x:Name="EnableNotificationAccess" Content="Request Windows notification access" HorizontalAlignment="Left"/>
  <TextBlock Text="Music app · open your player and play a song to detect it"/><ComboBox x:Name="MediaApp" Style="{StaticResource MediaPicker}" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,4,0,4"/><TextBlock x:Name="MediaHelp" FontSize="10" TextWrapping="Wrap"/>
  <TextBlock Text="Download folder"/><DockPanel><Button x:Name="BrowseDownloadFolder" Content="Browse" DockPanel.Dock="Right"/><TextBox x:Name="DownloadFolder"/></DockPanel>
  <TextBlock Text="Watchlist topics (up to 10 tickers or companies, comma-separated)"/><TextBox x:Name="SettingsWatchTopics"/>
  <CheckBox x:Name="EnableAllowPublicNews" Content="Allow Google News searches for my watchlist topics"/>
  <TextBlock Text="When enabled, Orby sends these topics to news.google.com every 5 minutes. Notification contents and files are never included." FontSize="10" TextWrapping="Wrap"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Focus minutes"/><TextBox x:Name="FocusMinutes"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Break reminder minutes (0 = off)"/><TextBox x:Name="BreakMinutes"/></StackPanel></Grid>
  <TextBlock Text="Favorite apps" FontWeight="Bold"/>
  <ListBox x:Name="FavoriteList" Height="75" Background="#22262D" Foreground="White" DisplayMemberPath="Name"/>
  <WrapPanel Margin="0,7,0,8"><Button x:Name="AddFavorite" Content="Add app"/><Button x:Name="RemoveFavorite" Content="Remove selected"/><Button x:Name="LaunchFavorite" Content="Open selected"/></WrapPanel>
  <Expander x:Name="SettingsDesktopControls" Header="Desktop controls" Foreground="#E3E3EB" Margin="0,8,0,12"><ContentControl x:Name="SettingsControlsHost" Height="320"/></Expander>


 </StackPanel></ScrollViewer></DockPanel>
</Window>

