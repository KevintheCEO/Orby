<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="580" Height="304" Margin="0,8,0,0" VerticalAlignment="Top" Visibility="Collapsed" TextElement.FontFamily="Segoe UI" UseLayoutRounding="True">
 <Grid.Resources><Style TargetType="Button"><Setter Property="Foreground" Value="#E7EAF1"/><Setter Property="Background" Value="#252832"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel><Button x:Name="DropClose" DockPanel.Dock="Right" Content="Close" ToolTip="Cancel the handoff and return home"/><Button x:Name="DropClear" DockPanel.Dock="Left" Content="Back" Margin="0,0,8,0"/><TextBlock Text="Files to AI" Foreground="White" FontSize="15" VerticalAlignment="Center"/></DockPanel>
 <Border Grid.Row="1" Background="#111119" CornerRadius="16" Padding="14" Margin="0,8,0,0"><Grid>
  <Grid x:Name="DropTarget"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Viewbox x:Name="DropTargetOrb" Width="50" Height="50"/><TextBlock Text="Drop your files here" Foreground="White" FontSize="16" Margin="0,8"/></StackPanel></Grid>
  <Grid x:Name="DropChat" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="DropChips" Orientation="Horizontal"/></ScrollViewer>
   <StackPanel Grid.Row="1"><TextBlock x:Name="DropHeading" Text="Choose an AI" Foreground="White" FontSize="15" Margin="0,6,0,8"/><UniformGrid x:Name="DropProviders" Columns="3" Height="48"/></StackPanel>
   <TextBlock x:Name="DropStatus" Grid.Row="2" Foreground="#ABB1C2" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6"/>
   <Grid x:Name="DropEditor" Grid.Row="3" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Viewbox x:Name="DropChatOrb" Width="32" Height="32"/>
    <TextBox x:Name="DropPrompt" Grid.Column="1" Height="58" Padding="8" Background="#242632" Foreground="White" CaretBrush="White" BorderThickness="0" FontSize="13" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="Optional message. Enter sends; Shift+Enter adds a line."/>
    <Button x:Name="DropSend" Grid.Column="2" Content="Send" Margin="8,0,0,0" ToolTip="Attach files and send to the chosen AI"/>
   </Grid>
  </Grid>
 </Grid></Border>
</Grid>
