<Canvas UseLayoutRounding="True" SnapsToDevicePixels="True" TextElement.FontWeight="Bold" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="54" Height="56">
  <Border x:Name="OrbBody" Canvas.Left="9" Canvas.Top="10" Width="36" Height="36" CornerRadius="18" BorderThickness="0.4" BorderBrush="#30FFFFFF" RenderTransformOrigin="0.5,0.5">
    <Border.Background>
      <RadialGradientBrush Center="0.32,0.22" GradientOrigin="0.32,0.22" RadiusX="0.85" RadiusY="0.85">
        <GradientStop Color="#F8F8F5" Offset="0"/><GradientStop Color="#E4E5E2" Offset="0.50"/><GradientStop Color="#BFC1C0" Offset="1"/>
      </RadialGradientBrush>
    </Border.Background>
    <Canvas x:Name="OrbFace" Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
      <Canvas.Clip><EllipseGeometry Center="18,18" RadiusX="17.7" RadiusY="17.7"/></Canvas.Clip>
      <Path x:Name="OrbEyeL" Fill="#111212" Data="M 10,15 A 2.5,3.7 0 1 1 10,22.4 A 2.5,3.7 0 1 1 10,15 Z"/>
      <Path x:Name="OrbEyeR" Fill="#111212" Data="M 23,15 A 2.5,3.7 0 1 1 23,22.4 A 2.5,3.7 0 1 1 23,15 Z"/>
      <Path x:Name="OrbPattern" Fill="#111212" Visibility="Collapsed"/>
      <Ellipse x:Name="OrbWhiteDot" Width="7" Height="7" Fill="#EEEFEA" Canvas.Left="14.5" Canvas.Top="5.5" Visibility="Collapsed"/>
      <Ellipse x:Name="OrbBlackDot" Width="7" Height="7" Fill="#111212" Canvas.Left="14.5" Canvas.Top="23.5" Visibility="Collapsed"/>
    </Canvas>
  </Border>
  <Ellipse x:Name="OrbLed" Width="5.5" Height="5.5" Canvas.Left="7.5" Canvas.Top="16" Fill="#65FF51" Opacity="0"/>
  <TextBlock x:Name="OrbCheck" Canvas.Left="40" Canvas.Top="8" Text="&#x2713;" FontSize="11" FontWeight="Bold" Foreground="#78FFAE" Opacity="0"/>
  <Border x:Name="OrbAsk" Width="11" Height="11" CornerRadius="5.5" Canvas.Left="40" Canvas.Top="9" Background="#FFC65C" Opacity="0"><TextBlock Text="!" FontSize="8" FontWeight="Bold" Foreground="#171108" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
</Canvas>
