<Border UseLayoutRounding="True" SnapsToDevicePixels="True" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TextElement.FontFamily="Segoe UI" TextElement.FontWeight="Bold" x:Name="EventCard" Width="584" Height="148" Margin="0,28,0,0" VerticalAlignment="Top" CornerRadius="18" Padding="12,10" BorderBrush="#25FFFFFF" BorderThickness="1" Visibility="Collapsed">
 <Border.Resources><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/></Style><Style TargetType="TextBox"><Setter Property="FontWeight" Value="Bold"/></Style><Style TargetType="CheckBox"><Setter Property="FontWeight" Value="Bold"/></Style><Style TargetType="ComboBox"><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="15,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.62"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Border.Resources>
 <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF18171C" Offset="0"/><GradientStop x:Name="EventColor" Color="#F522302C" Offset="0.15"/><GradientStop Color="#FF101116" Offset="1"/></LinearGradientBrush></Border.Background>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Viewbox Grid.RowSpan="3" x:Name="EventOrb" Width="72" Height="72"/>
  <TextBlock Grid.Column="1" x:Name="EventStatus" Text="Task finished" Foreground="#B9CEC4" FontSize="10" FontWeight="Bold" Margin="12,0,0,0"/>
  <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,2,0,7"><StackPanel><TextBlock x:Name="EventTitle" Foreground="#F7F8FA" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="EventDetail" Foreground="#AEB6C0" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/><StackPanel x:Name="EventChoices" Visibility="Collapsed" Margin="0,8,0,0"/><TextBox x:Name="EventPrompt" Visibility="Collapsed" Height="27" Margin="0,5,0,0" Padding="6,3" Background="#262433" Foreground="White" BorderBrush="#3A3748" FontSize="11" AcceptsReturn="True" ToolTip="Type a prompt. Enter sends; Shift+Enter adds a line."/></StackPanel></ScrollViewer>
  <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="12,0,0,0"><Button x:Name="EventDeny" Content="Deny" Background="#29282B" Foreground="#E3E6EB" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="EventApprove" Content="Allow once" Background="#EDF2FA" Foreground="#182332" Visibility="Collapsed"/><Button x:Name="EventOpen" Content="Open ChatGPT" Background="#EDF2FA" Foreground="#182332"/><Button x:Name="EventDismiss" Content="Done" Margin="8,0,0,0" Background="#29282B" Foreground="#E3E6EB"/></StackPanel>
 </Grid>
</Border>
