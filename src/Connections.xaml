<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Connect your AI · Orby" Width="510" Height="650" WindowStartupLocation="CenterScreen" Background="#09090D" Foreground="#EFEFF6" FontFamily="Segoe UI" FontWeight="Bold" ResizeMode="NoResize">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#24242E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#454552"/></Style></Window.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24"><TextBlock Text="Your AI. Your Orby." FontSize="24"/><TextBlock Text="Pair one or more AIs. Sign in inside each app." Foreground="#AAAABB" Margin="0,8,0,20"/>
<Border Background="#15151D" CornerRadius="14" Padding="14" Margin="0,0,0,10"><StackPanel><StackPanel Orientation="Horizontal"><Path x:Name="ChatLogo" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="ChatGPT / Codex" FontSize="16"/></StackPanel><TextBlock x:Name="ChatStatus" Text="Checking local connection" FontSize="11" Margin="0,4,0,8"/><WrapPanel><Button x:Name="ConnectChat" Content="Connect"/><Button x:Name="DownloadChat" Content="Get app"/></WrapPanel></StackPanel></Border>
<Border Background="#15151D" CornerRadius="14" Padding="14" Margin="0,0,0,10"><StackPanel><StackPanel Orientation="Horizontal"><Path x:Name="ClaudeLogo" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Claude" FontSize="16"/></StackPanel><TextBlock x:Name="ClaudeStatus" Text="Open Claude to detect activity" FontSize="11" Margin="0,4,0,8"/><WrapPanel><Button x:Name="ConnectClaude" Content="Connect"/><Button x:Name="DownloadClaude" Content="Get app"/></WrapPanel><Button x:Name="ClaudeCodeSync" Content="Enable Code sync" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock x:Name="ClaudeCodeNote" Text="Code uses activity hooks. Chat follows its visible controls." FontSize="11" Foreground="#9999AD" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Border Background="#15151D" CornerRadius="14" Padding="14"><StackPanel><StackPanel Orientation="Horizontal"><Path x:Name="GeminiLogo" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Gemini" FontSize="16"/></StackPanel><TextBlock x:Name="GeminiStatus" Text="Open Gemini to detect activity" FontSize="11" Margin="0,4,0,8"/><WrapPanel><Button x:Name="ConnectGemini" Content="Connect"/><Button x:Name="DownloadGemini" Content="Get app"/></WrapPanel></StackPanel></Border>
<TextBlock Text="No API key. Your sign-in stays in your AI app." FontSize="11" Foreground="#8D8D9F" Margin="0,14,0,0"/>
</StackPanel></ScrollViewer></Window>
