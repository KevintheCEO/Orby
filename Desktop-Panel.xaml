<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="0,4,0,10">
 <Grid.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#242729"/><Setter Property="Foreground" Value="#F2F4F2"/><Setter Property="BorderBrush" Value="#373B3D"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#70CCAA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#171A1B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3B4042"/><Setter Property="Padding" Value="7,6"/><Setter Property="Margin" Value="0,0,6,5"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#0E0F11"/><Setter Property="Foreground" Value="#F1F2F4"/><Setter Property="BorderBrush" Value="#303637"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F2F4"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#C6D3CD"/><Setter Property="Padding" Value="13,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="#141518" CornerRadius="7,7,0,0" Margin="0,0,3,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#1D1F23"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Grid.Resources>
 <TabControl x:Name="DesktopTabs" Background="#0E0F11" BorderBrush="#303637" Padding="10" Height="310">
  <TabItem Header="Home">
   <StackPanel>
    <TextBlock Text="NOW PLAYING" Foreground="#70CCAA" FontWeight="SemiBold" FontSize="10"/>
    <TextBlock x:Name="MusicTitle" Text="Waiting for a media app" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,1" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="MusicDetail" Text="System playback controls" Foreground="#929E99" Margin="0,0,0,7" TextTrimming="CharacterEllipsis"/>
    <WrapPanel><Button x:Name="MediaPrevious" Content="Previous"/><Button x:Name="MediaPlay" Content="Play / pause"/><Button x:Name="MediaNext" Content="Next"/><Button x:Name="VolumeDown" Content="Vol -"/><Button x:Name="VolumeUp" Content="Vol +"/><Button x:Name="MuteAudio" Content="Mute"/></WrapPanel>
    <Border Background="#1A2020" CornerRadius="9" Padding="10" Margin="0,6,0,8"><TextBlock x:Name="HealthSummary" Text="Connecting to computer health" TextWrapping="Wrap"/></Border>
    <DockPanel><Button x:Name="OpenDownloads" Content="Open folder" DockPanel.Dock="Right"/><TextBlock Text="DOWNLOADS" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Foreground="#70CCAA"/></DockPanel>
    <TextBlock x:Name="DownloadSummary" Text="Watching for new files" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
    <WrapPanel><Button x:Name="OpenFiles" Content="Files"/><Button x:Name="FavoriteApps" Content="Apps"/><Button x:Name="TakeScreenshot" Content="Screenshot"/><Button x:Name="FocusToggle" Content="Start focus"/><Button x:Name="OpenSettings" Content="Settings"/></WrapPanel>
    <TextBlock x:Name="ConnectionNote" Text="Orby stays quiet until something changes" Foreground="#7A8881" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </TabItem>
  <TabItem Header="Alerts">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><Button x:Name="QuietToggle" Content="Quiet mode: off"/><Button x:Name="MarkAlertsRead" Content="Mark viewed"/><Button x:Name="TestAlert" Content="Test alert"/><Button x:Name="ShowWindowsNotifications" Content="Windows notifications"/></WrapPanel>
    <ListBox x:Name="AlertList" Grid.Row="1" DisplayMemberPath="Display"/>
    <DockPanel Grid.Row="2" Margin="0,7,0,0"><Button x:Name="OpenAlertLink" Content="Open selected link" DockPanel.Dock="Right"/><TextBlock x:Name="NotificationConnection" Text="Connecting" Foreground="#9398A1" FontSize="10" TextWrapping="Wrap"/></DockPanel>
   </Grid>
  </TabItem>
  <TabItem Header="Planner">
   <StackPanel>
    <TextBlock Text="REMIND ME" Foreground="#70CCAA" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,7"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ReminderTitle" Text="Take a break"/><TextBox x:Name="ReminderMinutes" Grid.Column="1" Text="10" ToolTip="Minutes from now"/><Button x:Name="AddReminder" Grid.Column="2" Content="Add"/></Grid>
    <TextBlock x:Name="PlannerMessage" Text="Reminders are saved locally" Foreground="#9398A1" FontSize="10" Margin="0,0,0,5"/>
    <ListBox x:Name="ReminderList" Height="100" DisplayMemberPath="Display"/>
    <WrapPanel Margin="0,7,0,4"><Button x:Name="RemoveReminder" Content="Cancel selected"/><Button x:Name="PlannerFocus" Content="Start / stop focus"/></WrapPanel>
    <TextBlock x:Name="FocusSummary" Text="Focus timer is off"/>
   </StackPanel>
  </TabItem>
  <TabItem Header="Watchlist">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WatchTopics" ToolTip="Tickers or companies, separated by commas"/><Button x:Name="SaveWatchTopics" Grid.Column="1" Content="Save topics"/></Grid>
    <TextBlock Grid.Row="1" Text="Company and earnings headlines. New stories appear every 5 minutes." Foreground="#9398A1" FontSize="10" Margin="0,0,0,7"/>
    <ListBox x:Name="NewsList" Grid.Row="2" DisplayMemberPath="Display"/>
    <DockPanel Grid.Row="3" Margin="0,6,0,0"><Button x:Name="OpenNews" Content="Read selected" DockPanel.Dock="Right"/><TextBlock x:Name="WatchStatus" Text="Add topics such as NVDA, AAPL or Microsoft" Foreground="#9398A1" FontSize="10" TextWrapping="Wrap"/></DockPanel>
   </Grid>
  </TabItem>
  <TabItem Header="Files">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="FileDropZone" Background="#141518" BorderBrush="#34383E" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
     <StackPanel><TextBlock Text="Drop files onto Orby" FontSize="16" FontWeight="SemiBold" Foreground="#F5F6F8"/><TextBlock x:Name="ShelfMessage" Text="Local copies only. Originals stay in place. Up to 100 MB per file." Foreground="#9398A1" Margin="0,5,0,0"/></StackPanel>
    </Border>
    <ListBox x:Name="ShelfList" Grid.Row="1" DisplayMemberPath="Display"/>
    <WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="ShelfAdd" Content="Add file"/><Button x:Name="ShelfReveal" Content="Show selected"/><Button x:Name="ShelfFolder" Content="Open shelf folder"/></WrapPanel>
   </Grid>
  </TabItem>
 </TabControl>
</Grid>
