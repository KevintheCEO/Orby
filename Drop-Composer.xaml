<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="580" Height="218" Margin="0,-40,0,0" VerticalAlignment="Top" Visibility="Collapsed">
 <Grid.Resources><Style TargetType="Button"><Setter Property="Foreground" Value="#DBE3E0"/><Setter Property="Background" Value="#252A2B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Orientation="Horizontal"><Button x:Name="DropClose" Content="&#x2302;" ToolTip="Close"/><Button Content="&#x25CF;" IsEnabled="False" Margin="6,0,0,0"/><Button x:Name="DropClear" Content="+" ToolTip="Clear files for a new chat" Margin="6,0,0,0"/></StackPanel>
 <Grid Grid.Row="1">
  <Border x:Name="DropTarget" CornerRadius="16" Background="#101B18"><Grid>
   <Rectangle RadiusX="16" RadiusY="16" Stroke="#62A98B" StrokeThickness="1" StrokeDashArray="4 3" Margin="1"/>
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Drop your files here" Foreground="#BDCEC5" FontSize="14" HorizontalAlignment="Center"/><TextBlock Text="PDF   Images   Documents" Foreground="#64776B" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,7"/><Viewbox x:Name="DropTargetOrb" Width="52" Height="54"/></StackPanel>
  </Grid></Border>
  <Border x:Name="DropChat" CornerRadius="16" Background="#14141E" Padding="12" Visibility="Collapsed"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
   <WrapPanel x:Name="DropChips"/>
   <TextBlock x:Name="DropStatus" Grid.Row="1" Text="What should ChatGPT do with these files?" Foreground="#9497AA" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8"/>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Viewbox x:Name="DropChatOrb" Width="35" Height="35"/>
    <Border Grid.Column="1" Background="#222235" CornerRadius="16" Padding="10,4"><TextBox x:Name="DropPrompt" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="12" AcceptsReturn="True" ToolTip="Type a prompt. Enter sends; Shift+Enter adds a line."/></Border>
    <Button x:Name="DropSend" Grid.Column="2" Content="&#x2191;" FontSize="18" Margin="4,0,0,0" ToolTip="Send files and prompt"/>
   </Grid>
  </Grid></Border>
 </Grid>
</Grid>